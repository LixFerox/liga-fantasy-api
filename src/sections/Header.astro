---
import { Icon } from "astro-icon/components";
import Profile from "~/components/Profile.astro";
---

<header
  class="sticky top-0 z-50 backdrop-blur-lg bg-white/50 border-b border-gray-200 shadow-md"
>
  <div class="max-w-7xl mx-auto grid grid-cols-2 items-center py-2 px-4">
    <picture class="justify-self-start">
      <a
        href="/"
        class="flex items-center gap-2 hover:scale-105 transition-transform duration-300"
      >
        <div class="bg-icon p-2 rounded-lg text-white">
          <Icon name="picon:football" class="size-10" />
        </div>
        <h1 class="font-bold italic lg:text-xl text-lg text-gray-800">
          Fantasy Stats
        </h1>
      </a>
    </picture>

    <div class="justify-self-end lg:block hidden">
      <Profile />
    </div>
  </div>
</header>
