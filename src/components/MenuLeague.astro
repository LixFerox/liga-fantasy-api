---
import { Icon } from "astro-icon/components";

export interface Props {
  leagueId: string;
}

const { leagueId } = Astro.props;

const currentPath = Astro.url.pathname;
const isRanking =
  currentPath === `/league/${leagueId}/` ||
  currentPath === `/league/${leagueId}`;
const isMarket = currentPath === `/league/${leagueId}/market`;
---

<nav
  class="my-10 w-full flex justify-between items-center rounded-lg bg-gray-200"
>
  <a
    href={`/league/${leagueId}/`}
    class={`flex items-center gap-2 font-semibold p-1.5 rounded-lg w-full justify-center ${isRanking ? "bg-gray-300" : ""}`}
  >
    <Icon name="mdi:trophy-outline" class="size-5" />
    Clasificación
  </a>
  <a
    href={`/league/${leagueId}/market`}
    class={`flex items-center gap-2 font-semibold p-1.5 rounded-lg w-full justify-center ${isMarket ? "bg-gray-300" : ""}`}
  >
    <Icon name="mdi:cart-outline" class="size-5" />
    Mercado
  </a>
</nav>
