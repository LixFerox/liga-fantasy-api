---
import { Icon } from "astro-icon/components";
interface Props {
  title: string;
  url: string;
  members: number;
  description: string;
  isPremium: boolean;
}
const { title, url, members, description, isPremium } = Astro.props;
---

<section
  class="flex flex-col items-stretch p-6 rounded-lg shadow-md border border-gray-200 bg-white"
>
  <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
    {title}
    {isPremium && <Icon name="mdi:crown" class="size-5 text-yellow-500" />}
  </h3>
  <p class="text-gray-700">{description}</p>
  <p class="flex items-center gap-2 text-gray-600 mt-8">
    <Icon name="mdi:user" class="size-6" />
    {members}/16 miembros
  </p>
  <hr class="text-gray-300 mt-3 mb-6" />
  <a
    href={url}
    class={`border border-gray-300 rounded-md px-4 py-2 text-center font-medium ${isPremium ? "bg-yellow-500" : "bg-icon"} hover:brightness-90 transition-all text-white`}
    >Ver Liga</a
  >
</section>
