---
import Layout from "~/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout menuHidden title="Página no encontrada">
  <main
    class="py-6 flex flex-col items-center justify-center from-green-50/50 to-green-50 bg-gradient-to-b"
  >
    <div class="w-full max-w-2xl flex flex-col items-center px-4 text-center">
      <div class="mb-8 relative">
        <div
          class="w-32 h-32 bg-red-100 rounded-full flex items-center justify-center"
        >
          <Icon name="mdi:alert-circle-outline" class="size-16 text-red-500" />
        </div>
        <div
          class="absolute inset-0 w-32 h-32 bg-red-100 rounded-full animate-ping opacity-20"
        >
        </div>
      </div>

      <h1 class="text-6xl font-bold text-gray-800 mb-4">404</h1>
      <h2 class="text-3xl font-bold text-gray-700 mb-4">
        ¡Ups! Página no encontrada
      </h2>
      <p class="text-gray-600 text-lg mb-8 max-w-md leading-relaxed">
        Lo sentimos, pero la página que estás buscando no existe o ha sido
        movida. Puede que hayas escribido mal la URL o que el enlace esté
        desactualizado.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg"
        >
          <Icon name="mdi:home" class="size-5" />
          Ir al Inicio
        </a>

        <button
          onclick="window.history.back()"
          class="inline-flex items-center gap-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-6 py-3 rounded-lg transition-colors duration-200"
        >
          <Icon name="mdi:arrow-left" class="size-5" />
          Volver Atrás
        </button>
      </div>

      <div class="w-full max-w-md">
        <h3 class="text-lg font-semibold text-gray-700 mb-4">
          ¿Qué puedes hacer?
        </h3>
        <div class="grid gap-3 text-left">
          <a
            href="/home"
            class="flex items-center gap-3 p-3 bg-white rounded-lg border hover:border-green-300 hover:bg-green-50 transition-colors duration-200"
          >
            <Icon name="mdi:trophy-outline" class="w-5 h-5 text-green-600" />
            <span class="text-gray-700">Ver mis ligas</span>
          </a>

          <a
            href="/"
            class="flex items-center gap-3 p-3 bg-white rounded-lg border hover:border-green-300 hover:bg-green-50 transition-colors duration-200"
          >
            <Icon name="mdi:login" class="w-5 h-5 text-green-600" />
            <span class="text-gray-700">Iniciar sesión</span>
          </a>
        </div>
      </div>

      <div
        class="mt-12 p-4 bg-blue-50 rounded-lg border border-blue-200 max-w-md"
      >
        <div class="flex items-start gap-3">
          <Icon
            name="mdi:information-outline"
            class="size-5 text-blue-600 mt-0.5"
          />
          <div class="text-sm text-blue-800">
            <p class="font-medium mb-1">¿Necesitas ayuda?</p>
            <p>
              Si crees que esto es un error, verifica la URL o contacta con
              soporte.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
