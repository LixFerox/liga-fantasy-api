---
import Layout from "~/layouts/Layout.astro";
import SectionLeague from "~/components/SectionLeague.astro";
import { getLeagues } from "~/lib/api/leagues";
import type { League } from "~/lib/types/league/league";
import { clearAuthCookie, isAuthError } from "~/lib/auth/utils";

const cookie = Astro.cookies.get("auth");
if (!cookie) {
  return Astro.redirect("/");
}

let leagues: League[] = [];

try {
  leagues = await getLeagues(cookie.value);
} catch (error) {
  if (isAuthError(error)) {
    clearAuthCookie(Astro.cookies);
    return Astro.redirect("/");
  }
  throw error;
}
---

<Layout menuHidden title="Tus Ligas">
  <main
    class="py-6 flex flex-col items-center from-green-50/50 to-green-50 bg-gradient-to-b"
  >
    <div class="w-full max-w-7xl flex flex-col items-center px-4">
      <h2 class="text-2xl font-bold text-gray-800">Tus Ligas Fantasy</h2>
      <p class="text-gray-600 mt-4">
        Aquí puedes ver todas tus ligas fantasy y ver información detallada
        sobre cada una.
      </p>
      <article
        class={"w-full mt-15 " +
          (leagues.length > 0
            ? "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            : "text-center")}
      >
        {
          leagues.length > 0 ? (
            leagues.map(
              ({ id, name, description, managersNumber, premium }) => (
                <SectionLeague
                  title={name}
                  url={`/league/${id}`}
                  members={managersNumber}
                  description={description}
                  isPremium={premium}
                />
              )
            )
          ) : (
            <p class="text-gray-600 text-xl">No tienes ligas fantasy.</p>
          )
        }
      </article>
    </div>
  </main>
</Layout>
