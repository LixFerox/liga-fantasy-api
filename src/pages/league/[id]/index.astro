---
import Layout from "~/layouts/Layout.astro";
import { getClasification, getLeagues } from "~/lib/api/leagues";
import MenuLeague from "~/components/MenuLeague.astro";
import type { League } from "~/lib/types/league/league";
import type { Clasification } from "~/lib/types/league/clasification";
import RankingCard from "~/components/RankingCard.astro";
import { clearAuthCookie, isAuthError } from "~/lib/auth/utils";

const cookie = Astro.cookies.get("auth");
if (!cookie) {
  return Astro.redirect("/");
}
const { id } = Astro.params;

let league: League | undefined;
let clasification: Clasification[] = [];

try {
  const leagues = await getLeagues(cookie.value);
  league = leagues.find((league: League) => league.id === id);

  if (!league) {
    return Astro.redirect("/404");
  }

  clasification = await getClasification(league.id, cookie.value);
} catch (error) {
  if (isAuthError(error)) {
    clearAuthCookie(Astro.cookies);
    return Astro.redirect("/");
  }
  throw error;
}
---

<Layout title={league?.name}>
  <main
    class="py-6 flex flex-col items-center from-green-50/50 to-green-50 bg-gradient-to-b"
  >
    <div class="w-full max-w-7xl flex flex-col items-center px-4">
      <h2 class="text-2xl font-bold text-gray-800">{league?.name}</h2>
      <MenuLeague leagueId={id!} />
      <article
        class="w-full shadow-md border border-gray-200 bg-white rounded-lg p-6"
      >
        <h3 class="text-lg font-medium">Clasificación general</h3>
        <p class="text-gray-600">
          Posiciones actuales de todos los equipos en la liga
        </p>
        <div>
          <div class="grid grid-cols-5 text-center mt-6 mb-2 font-medium">
            <div class="lg:block hidden">Pos.</div>
            <div class="lg:block hidden">Manager</div>
            <div class="lg:block hidden">Puntos</div>
            <div class="lg:block hidden">Valor Equipo</div>
            <div class="lg:block hidden">Cambio</div>
          </div>
          {
            clasification.map(
              ({ position, previousPosition, points, team }) => (
                <RankingCard
                  position={position}
                  manager={team.manager.managerName}
                  avatar={team.manager.avatar}
                  points={points}
                  teamValue={team.teamValue}
                  position={position}
                  previousPosition={previousPosition}
                  isAdmin={team.isAdmin}
                />
              )
            )
          }
        </div>
      </article>
    </div>
  </main>
</Layout>
